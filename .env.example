OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FAL_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Clips (P1)
CLIPS_ENABLED=                        # none | all | fr,en | user:<uuid>[,user:<uuid>] — dev : vide = all
CLIPS_FORCE_OPENAI_WHISPER=           # 1 = force whisper-1 OpenAI (bypass Groq)
CLIPS_BURN_PNG_OVERLAY=               # 1 = spike burn 2-pass PNG overlay (défaut off)
CRON_SECRET=                          # Bearer du cron /api/cron/process-clips — fail-closed hors dev

# Rate limiting (P3+)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email (P3+)
RESEND_API_KEY=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

