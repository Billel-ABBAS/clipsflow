# ── ClipsFlow — variables d'environnement ────────────────────────────────────
# Copie ce fichier → .env.local et remplis. Jamais de vraie clé ici.

# Supabase (obligatoire — auth + DB + storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only, jamais côté client

# IA — transcription + traduction sous-titres (obligatoire pour le rendu)
GROQ_API_KEY=                         # Whisper via Groq (rapide, défaut)
OPENAI_API_KEY=                       # fallback Whisper + traduction des cues
CLIPS_TRANSLATION_OPENAI_MODEL=gpt-5.4-mini  # optionnel, défaut : gpt-5.4-mini
# Autorise explicitement les appels payants ci-dessous (jamais activé par défaut).
CLIPS_AI_BUDGET_AUTHORIZED=            # true après validation du budget fournisseurs
# Analyse longue : modèle rapide pour tous les candidats, jamais Opus.
CLIPS_LONGFORM_ANALYSIS_MODEL=gpt-5.4-mini
# Identifiant API Anthropic documenté; les appels restent fermés par défaut.
ANTHROPIC_API_KEY=                     # server-only; réutilisée depuis .env.local, jamais NEXT_PUBLIC_
CLIPS_CREATIVE_DIRECTOR_MODEL=claude-opus-5-5
CLIPS_CREATIVE_DIRECTOR_ENABLED=false  # true uniquement avec budget explicitement autorisé
GEMINI_API_KEY=                        # optionnel, priorité à Gemini s'il est configuré
CLIPS_VISUAL_ANALYSIS_PROVIDER=auto   # auto | gemini | openai ; auto réutilise OPENAI_API_KEY en repli
CLIPS_VISUAL_ANALYSIS_MODEL=           # optionnel ; défaut gemini-3.8-flash ou gpt-5.4-mini selon fournisseur
CLIPS_VISUAL_ANALYSIS_ENABLED=         # true après validation du budget et de l'usage
# Jev évalue le classement en mode shadow (aucun changement au résultat servi).
TYPESAFE_API_KEY=                      # server-only
CLIPS_JEV_HOOK_SCORE=                  # off par défaut ; shadow après autorisation/budget validé
# Sound design : musique instrumentale, sound effects et ducking automatique.
ELEVENLABS_API_KEY=                    # server-only
CLIPS_ELEVENLABS_MUSIC_MODEL=music_v2_5
CLIPS_ELEVENLABS_SOUND_MODEL=eleven_text_to_sound_v2
CLIPS_ELEVENLABS_ENABLED=false         # true après validation licence/crédits et budget

# Shorts — worker d'analyse asynchrone (service Railway séparé du worker Clips)
SHORTS_ANALYSIS_WORKER_ENABLED=        # true uniquement après configuration worker + budget IA
SHORTS_ANALYSIS_WORKER_READY=false     # Vercel uniquement; true après déploiement et smoke réussi du worker
# Quota mensuel de durée de source analysée, à renseigner par plan avant activation.
# Valeurs en secondes; vide = analyses bloquées, 0 = aucune analyse incluse.
SHORTS_ANALYSIS_MONTHLY_SOURCE_SECONDS_FREE=
SHORTS_ANALYSIS_MONTHLY_SOURCE_SECONDS_SOLO=
SHORTS_ANALYSIS_MONTHLY_SOURCE_SECONDS_PRO=
SHORTS_ANALYSIS_MONTHLY_SOURCE_SECONDS_STUDIO=
SHORTS_MAX_SOURCE_BYTES=8589934592     # plafond applicatif; Supabase Pro+ et global Storage >= 8 Gio requis
YOUTUBE_PUBLISH_WORKER_ENABLED=        # true uniquement après configuration du worker de publication
YOUTUBE_PUBLIC_UPLOADS_ENABLED=        # true seulement après l'audit requis du projet YouTube API

# Clips — flags (dev)
CLIPS_ENABLED=                        # none | all | fr,en | user:<uuid> — vide = all en dev
CLIPS_FORCE_OPENAI_WHISPER=           # 1 = force OpenAI whisper-1 (bypass Groq)
CLIPS_BURN_PNG_OVERLAY=               # 1 = spike burn 2-pass PNG overlay

# Cron (prod — Bearer du worker /api/cron/process-clips, fail-closed hors dev)
CRON_SECRET=

# Stripe (billing — Phase 3)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=                     # server-only, jamais côté client
STRIPE_WEBHOOK_SECRET=                 # webhook Stripe
STRIPE_PRICE_ID_SOLO=                  # price_id Stripe (test)
STRIPE_PRICE_ID_PRO=                   # price_id Stripe (test)
STRIPE_PRICE_ID_STUDIO=                # price_id Stripe (test)
NEXT_PUBLIC_APP_URL=                   # https://clipsflow-liart.vercel.app (prod) ou http://localhost:3000 (dev)

# YouTube — OAuth serveur, jamais dans le navigateur. L'URI de retour doit
# être exactement celle déclarée dans Google Cloud (HTTPS hors localhost).
# La clé de chiffrement est une clé aléatoire encodée base64 de 32 octets,
# stockée seulement chez l'hébergeur.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=            # https://<app>/api/youtube/oauth/callback (identique à Google Cloud)
YOUTUBE_OAUTH_STATE_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY=
