# One-shot Railway Cron image for ClipsFlow renders.  It contains the Node
# pipeline, the packaged ffmpeg binary and the local font assets.  Runtime
# limits (1 vCPU / 1 GiB) and the five-minute Cron schedule are configured in
# Railway, not baked into the image.
FROM node:25-bookworm-slim

WORKDIR /app

# ffmpeg is supplied by @ffmpeg-installer/ffmpeg. fontconfig and DejaVu are a
# fallback for libass glyph discovery; project fonts/ are copied below.
RUN DEBIAN_FRONTEND=noninteractive apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends fontconfig fonts-dejavu-core \
  && rm -rf /var/lib/apt/lists/*

# Keep package-manager installation separate from apt so build logs identify
# registry stalls and the system-package layer can be cached independently.
RUN npm install --global pnpm@11.20.0 --no-audit --no-fund \
  --fetch-retries=2 --fetch-timeout=30000

# Keep dev dependencies only for tsx, then switch the actual worker process
# to production mode. The lockfile is the sole dependency authority.
ENV NODE_ENV=development
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ENV NODE_ENV=production
CMD ["pnpm", "worker:clips"]
