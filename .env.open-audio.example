# Server / rendering-worker configuration. Never prefix a key with NEXT_PUBLIC_.
CLIPS_OPEN_AUDIO_ENABLED=false
CLIPS_OPEN_AUDIO_COMPUTE_AUTHORIZED=false
CLIPS_OPEN_AUDIO_BASE_URL=
CLIPS_OPEN_AUDIO_API_KEY=
# On the ACE-Step host, configure ACESTEP_API_KEY to the same private value.
# HTTPS + a private token (at least 16 characters) are required for a remote host.
# http://127.0.0.1:8001 is accepted only when ACE-Step is on the same machine.
# ELEVENLABS_API_KEY and CLIPS_ELEVENLABS_* do not activate the new engine.
